# Copie ce fichier en ".env" puis modifie les valeurs.
# Le fichier .env ne doit JAMAIS être publié sur GitHub (il est dans .gitignore).
# Ces valeurs sont des exemples pour un usage local uniquement.

# Postgres
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_postgres

# MinIO (le mot de passe doit faire au moins 8 caractères)
MINIO_ROOT_USER=atlas_minio
MINIO_ROOT_PASSWORD=change_me_minio

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_SECRET_KEY=change_me_long_random_string
# Optionnel : clé Fernet pour chiffrer les connexions Airflow
AIRFLOW_FERNET_KEY=
